      "target": "conf.example/road/screen/R1",
      "result": "pass",
      "checks": [
        {
          "code": "CRS-TRAFFIC-DEVICE",
          "severity": "info"
        }
      ]
    },
    {
      "file": "edited.png",
      "target": "conf.example/road/screen/R1",
      "result": "incomplete",
      "checks": [
        {
          "code": "CRS-TRAFFIC-DEVICE",
          "severity": "not_checked"
        }
      ]
    },
    {
      "file": "self-attested.png",
